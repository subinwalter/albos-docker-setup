FROM php:8.3-fpm

# Install dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libfreetype6-dev \
    libjpeg62-turbo-dev \
    libpng-dev \
    libzip-dev \
    unzip \
    vim \
    git \
    mariadb-client \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) gd mysqli pdo_mysql zip exif opcache

COPY custom-php.ini /usr/local/etc/php/conf.d/

WORKDIR /var/www/html_gp

# Add entrypoint script
COPY entrypoint-gigpeppers.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/entrypoint-gigpeppers.sh

ENTRYPOINT ["/usr/local/bin/entrypoint-gigpeppers.sh"]
CMD ["php-fpm"]
